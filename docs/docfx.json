{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/Mietex.CosmosDb",
          "files": [
            "Mietex.CosmosDb.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      },
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "articles/*.md",
          "articles/toc.yml",
          "migration/*.md",
          "migration/toc.yml",
          "api/*.md",
          "api/*.yml",
          "api/toc.yml"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "Mietex.CosmosDb",
      "_appFooter": "Mietex.CosmosDb — MIT licensed",
      "_enableSearch": true,
      "_disableContribution": false
    },
    "markdownEngineName": "markdig",
    "xrefService": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ]
  }
}
