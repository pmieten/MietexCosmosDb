    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mietex.CosmosDb\Mietex.CosmosDb.csproj" />
  </ItemGroup>

</Project>
